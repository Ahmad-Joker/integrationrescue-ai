# Copy to .env for local use (never commit .env). For a deployment, set these as platform environment variables.
# Everything is optional for local development. docs/DEPLOYMENT.md explains each variable.

# ---- decision maker
# deterministic (default: rule-based baseline, offline, no LLM) | gemini (live, needs GEMINI_API_KEY) | claude
IR_PROVIDER=deterministic
# GEMINI_API_KEY=            # Google AI Studio key (secret)
# gemini-3.1-flash-lite is the model the recorded live runs used (free tier); 2.5-flash is the code default.
IR_GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=         # secret; or `ant auth login`
IR_MODEL=claude-opus-5-5
IR_EFFORT=medium
IR_MAX_LLM_CALLS=30          # model calls per incident (1-200)

# ---- public competition demo (leave unset locally)
# IR_DEMO_MODE=1             # requires IR_ACCESS_TOKEN; disables auto-approval and UI-launched eval runs
# IR_ACCESS_TOKEN=           # secret, >= 16 chars: code judges enter before creating/approving incidents
# IR_ADMIN_TOKEN=            # secret, >= 16 chars, different from the access code: enables POST /api/admin/reset
# IR_CORS_ORIGINS=           # comma-separated exact origins; not needed when the dashboard is served by the API
# IR_STATIC_DIR=             # built dashboard folder to serve (the container sets /app/static)
# IR_TRUST_PROXY=1           # only behind a platform proxy that sets X-Forwarded-For
# IR_RATE_LIMIT_PER_MIN=30   # state-changing requests per client per minute
# IR_MAX_CONCURRENT_RUNS=3
# IR_MAX_LIVE_INCIDENTS_PER_DAY=15

# ---- storage (fictional runtime state)
# IR_VAR_DIR=./var
