# Copy to .env (never commit .env). All values optional.

# deterministic (default, offline, no LLM) | gemini (live, GEMINI_API_KEY) | claude (live, Anthropic credentials)
IR_PROVIDER=deterministic
# Live model settings (only used when IR_PROVIDER=claude)
IR_MODEL=claude-opus-5-5
IR_EFFORT=medium
IR_MAX_LLM_CALLS=30
# ANTHROPIC_API_KEY=   # or use `ant auth login`
# GEMINI_API_KEY=      # Google AI Studio key
IR_GEMINI_MODEL=gemini-2.5-flash

# Where simulated worlds, sandboxes and the incident DB are stored
# IR_VAR_DIR=./var
